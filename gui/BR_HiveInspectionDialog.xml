<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose">
    <GuiElement profile="newLayer"/>
    <Bitmap profile="dialogFullscreenBg" id="dialogBg"/>

    <GuiElement profile="brHiveInspectionBg" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgTopSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgBottom"/>

        <GuiElement profile="fs25_dialogContentContainer">
            <Text profile="brHiveInspectionText" text="" id="messageText"/>
        </GuiElement>

        <BoxLayout profile="fs25_dialogButtonBox">
            <Button profile="buttonOK" text="Swarm Control" onClick="onClickSwarmControl" id="swarmControlButton"/>
            <Button profile="buttonBack" text="$l10n_button_close" onClick="onClickBack" id="backButton"/>
        </BoxLayout>
    </GuiElement>

    <GUIProfiles>
        <Profile name="brHiveInspectionBg" extends="fs25_dialogBg">
            <height value="620px"/>
            <Variant name="mobile">
                <size value="1400px 720px"/>
            </Variant>
        </Profile>

        <Profile name="brHiveInspectionText" extends="fs25_dialogText">
            <position value="272px -36px"/>
            <size value="900px 565px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="top"/>
            <textSize value="14px"/>
            <textMaxNumLines value="30"/>
            <textLayoutMode value="wrap"/>
            <Variant name="mobile">
                <position value="290px -36px"/>
                <size value="1220px 620px"/>
                <textSize value="21px"/>
                <textMaxNumLines value="30"/>
            </Variant>
        </Profile>
    </GUIProfiles>
</GUI>
